{
  "name": "dnd-generator",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tsc": "tsc -p tsconfig.json && tsc -p cypress/tsconfig.json",
    "cypress:open": "cypress open",
    "lint": "oxlint src --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint src --fix --fix-suggestions",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt src --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "copy-to-clipboard": "^4.0.2",
    "jsoncrush": "^1.1.8",
    "npc-generator": "^1.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cypress": "^16.2.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-plugin-organize-imports": "^0.2.0",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^8.3.7"
  },
  "allowScripts": {
    "cypress@16.2.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
